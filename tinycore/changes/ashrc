# ~/.ashrc: Executed by SHells.
#
. /etc/init.d/tc-functions
if [ -n "$DISPLAY" ]
then
	`which editor >/dev/null` && EDITOR=editor || EDITOR=vi
else
	EDITOR=vi
fi
export EDITOR
export HISTFILESIZE=1000

# Alias definitions.
#
alias df='df -h'
alias du='du -h'

alias ls='ls -p'
alias ll='ls -l'
alias la='ls -la'

# Avoid errors... use -f to skip confirmation.
# alias cp='cp -i'
# alias mv='mv -i'
# alias rm='rm -i'

alias ce='cd /etc/sysconfig/tcedir'

alias chkb.sh='setkmap.sh ch'
alias dekb.sh='setkmap.sh de'
alias itkb.sh='setkmap.sh it'
alias uskb.sh='setkmap.sh us'

